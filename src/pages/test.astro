---
// El cuestionario (M-01). Todas las preguntas se generan aquí y el script las va mostrando de una en
// una. Las respuestas viven solo en una variable del script: no van a la URL, ni a localStorage, ni a
// ningún servidor (M-08).
import Base from '../layouts/Base.astro';
import Pregunta from '../components/Pregunta.astro';
import SelectorProvincia from '../components/SelectorProvincia.astro';
import { cargarPreguntas, cargarTerritorio, datosResultado } from '../lib/datos.ts';
import { recorrido, type PreguntaTest } from '../lib/perfil/cuestionario.ts';
import { CAMPOS_PERFIL, type TextosPerfil } from '../lib/compartir/tarjeta.ts';

const preguntas = cargarPreguntas();
const todas: PreguntaTest[] = preguntas.map(({ id, bloque, orden, etiqueta, tipo, obligatoria, solo_si }) => ({ id, bloque, orden, etiqueta, tipo, obligatoria, ...(solo_si && { soloSi: solo_si }) }));
const pasos = recorrido(todas);
const porId = new Map(preguntas.map((p) => [p.id, p]));
const territorio = cargarTerritorio();
const provincias = territorio.provincias.map(({ id, nombre, alias, ccaa }) => ({ id, nombre, alias, ccaa }));
const resultado = datosResultado();
// Textos de las opciones de las cuatro preguntas que puede llevar la imagen para compartir (S-02).
const textosPerfil: TextosPerfil = Object.fromEntries(
  CAMPOS_PERFIL.map((id) => [id, Object.fromEntries((porId.get(id)?.opciones ?? []).map((o) => [o.id, o.texto]))]),
);
// "<" escapado: ningún texto de los datos puede cerrar el <script> que los contiene.
const datos = JSON.stringify({ pasos, preguntas: todas, provincias, resultado, textosPerfil }).replace(/</g, "\\u003c");
---

<Base titulo="El test · Vota con Criterio" test>
  <script type="application/json" id="datos-test" set:html={datos} />

  <div class="interior">
    <div class="wrap">
      {
        pasos.map((paso, i) =>
          paso.tipo === 'pregunta' ? (
            <Pregunta pregunta={porId.get(paso.pregunta)!} todas={todas} atrasA={i === 0 ? '/' : undefined}>
              <SelectorProvincia />
            </Pregunta>
          ) : paso.tipo === 'provisional' ? (
            <section class="paso fin" data-paso="provisional" data-testid="resultado-provisional" hidden>
              <button class="quiz__back atras" type="button" data-atras>← Atrás</button>
              <p class="pill marca-provisional">Provisional</p>
              <h2 tabindex="-1">Tu resultado provisional</h2>
              <div class="resultado" data-resultado></div>
              <button class="btn btn--secondary" type="button" data-seguir data-testid="seguir">Seguir con más preguntas</button>
            </section>
          ) : (
            <section class="paso fin" data-paso="final" data-testid="resultado-final" hidden>
              <button class="quiz__back atras" type="button" data-atras>← Atrás</button>
              <h2 tabindex="-1">Tu resultado</h2>
              <div class="resultado" data-resultado></div>
            </section>
          ),
        )
      }
    </div>
  </div>
</Base>

<script>
  import { aplica, progreso, puedeAvanzar, respuestasEfectivas, type Paso, type PreguntaTest } from '../lib/perfil/cuestionario.ts';
  import { buscarProvincias, provinciaExacta, type ProvinciaBuscable } from '../lib/perfil/provincias.ts';
  import { conComunidad } from '../lib/afinidad/calculo.ts';
  import { pintarResultado, type DatosResultado } from '../scripts/resultado.ts';
  import type { TextosPerfil } from '../lib/compartir/tarjeta.ts';

  const { pasos, preguntas, provincias, resultado, textosPerfil } = JSON.parse(document.getElementById('datos-test')!.textContent!) as {
    pasos: Paso[];
    preguntas: PreguntaTest[];
    provincias: (ProvinciaBuscable & { ccaa: string })[];
    resultado: DatosResultado;
    textosPerfil: TextosPerfil;
  };
  const ccaaDe = new Map(provincias.map((p) => [p.id, p.ccaa]));
  const clave = (p: Paso) => (p.tipo === 'pregunta' ? `pregunta:${p.pregunta}` : p.tipo);
  const secciones = pasos.map((p) => document.querySelector<HTMLElement>(`[data-paso="${clave(p)}"]`)!);

  /** Las respuestas del visitante. Solo en memoria: se pierden al cerrar o recargar la página. */
  const respuestas: Record<string, string> = {};
  let actual = 0;
  const AVANCE_MS = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 400;

  /** Si un paso se enseña con las respuestas actuales (las preguntas condicionales pueden saltarse). */
  const visible = (p: Paso) => p.tipo !== 'pregunta' || aplica(preguntas.find((x) => x.id === p.pregunta)!, respuestas);

  /** Va al paso i o, si es una pregunta que no aplica, al siguiente visible en la misma dirección. */
  function mostrar(i: number, direccion: 1 | -1 = 1) {
    while (i > 0 && i < pasos.length - 1 && !visible(pasos[i]!)) i += direccion;
    secciones[actual]!.hidden = true;
    actual = i;
    const paso = pasos[actual]!;
    if (paso.tipo === 'pregunta') {
      // El contador cuenta solo las preguntas que se le hacen a esta persona.
      const { texto, fraccion } = progreso(preguntas, paso.pregunta, respuestas);
      const s = secciones[actual]!;
      s.querySelector('[data-progreso-texto]')!.textContent = texto;
      s.querySelector('[data-progreso-pct]')!.textContent = `${Math.round(fraccion * 100)}\u202f%`;
      s.querySelector<HTMLElement>('[data-progreso-barra]')!.style.setProperty('--avance', `${Math.round(fraccion * 100)}%`);
    } else {
      const efectivas = respuestasEfectivas(preguntas, respuestas);
      const pendientes = new Set(preguntas.filter((p) => p.bloque === 'ampliado' && aplica(p, efectivas) && efectivas[p.id] === undefined).map((p) => p.id));
      pintarResultado(secciones[actual]!.querySelector('[data-resultado]')!, resultado, conComunidad(efectivas, ccaaDe), {
        provisional: paso.tipo === 'provisional',
        pendientes,
        accion: secciones[actual]!.querySelector<HTMLElement>('[data-seguir]'),
        textosPerfil,
      });
    }
    secciones[actual]!.hidden = false;
    secciones[actual]!.querySelector<HTMLElement>('h2')!.focus();
    window.scrollTo(0, 0);
  }

  function siguiente() {
    const paso = pasos[actual]!;
    if (paso.tipo === 'pregunta') {
      const p = preguntas.find((x) => x.id === paso.pregunta)!;
      if (!puedeAvanzar(p, respuestas[p.id])) return;
    }
    if (actual < pasos.length - 1) mostrar(actual + 1);
  }

  for (const s of secciones) {
    s.querySelector('[data-atras]')?.addEventListener('click', () => actual > 0 && mostrar(actual - 1, -1));
    s.querySelector('[data-seguir]')?.addEventListener('click', siguiente);
  }

  // Opciones: al marcar una, se rellena su marca y la pregunta avanza sola.
  for (const boton of document.querySelectorAll<HTMLButtonElement>('.opcion')) {
    boton.addEventListener('click', () => {
      const seccion = boton.closest<HTMLElement>('[data-paso]')!;
      const id = seccion.dataset.paso!.replace('pregunta:', '');
      respuestas[id] = boton.dataset.valor!;
      for (const b of seccion.querySelectorAll('.opcion')) b.setAttribute('aria-pressed', String(b === boton));
      setTimeout(siguiente, AVANCE_MS);
    });
  }

  // Provincia: autocompletado con el patrón combobox + listbox.
  const campo = document.getElementById('provincia-campo') as HTMLInputElement;
  const lista = document.getElementById('provincia-lista') as HTMLUListElement;
  const aviso = document.getElementById('provincia-aviso')!;
  const botonSiguiente = document.querySelector<HTMLButtonElement>('[data-siguiente]')!;
  let sugerencias: ProvinciaBuscable[] = [];
  let activa = -1;

  function elegir(p: ProvinciaBuscable | undefined) {
    if (p) {
      respuestas.provincia = p.id;
      campo.value = p.nombre;
      aviso.textContent = '';
    } else {
      delete respuestas.provincia;
    }
    botonSiguiente.setAttribute('aria-disabled', String(!p));
    cerrarLista();
  }

  function cerrarLista() {
    lista.hidden = true;
    lista.replaceChildren();
    campo.setAttribute('aria-expanded', 'false');
    campo.removeAttribute('aria-activedescendant');
    activa = -1;
  }

  function marcarActiva(i: number) {
    activa = i;
    lista.querySelectorAll('li').forEach((li, j) => li.setAttribute('aria-selected', String(j === i)));
    const li = lista.children[i] as HTMLElement | undefined;
    if (li) {
      campo.setAttribute('aria-activedescendant', li.id);
      li.scrollIntoView({ block: 'nearest' });
    }
  }

  campo.addEventListener('input', () => {
    elegir(provinciaExacta(provincias, campo.value));
    if (respuestas.provincia) return;
    sugerencias = buscarProvincias(provincias, campo.value);
    if (!sugerencias.length) return cerrarLista();
    lista.replaceChildren(
      ...sugerencias.map((p, i) => {
        const li = document.createElement('li');
        li.id = `provincia-${p.id}`;
        li.role = 'option';
        li.textContent = p.nombre;
        li.setAttribute('aria-selected', 'false');
        li.addEventListener('mousedown', (e) => e.preventDefault());
        li.addEventListener('click', () => elegir(sugerencias[i]));
        return li;
      }),
    );
    lista.hidden = false;
    campo.setAttribute('aria-expanded', 'true');
    activa = -1;
  });

  campo.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' && sugerencias.length && !lista.hidden) {
      e.preventDefault();
      marcarActiva(Math.min(activa + 1, sugerencias.length - 1));
    } else if (e.key === 'ArrowUp' && !lista.hidden) {
      e.preventDefault();
      marcarActiva(Math.max(activa - 1, 0));
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (!lista.hidden && activa >= 0) elegir(sugerencias[activa]);
      else if (!lista.hidden && sugerencias.length === 1) elegir(sugerencias[0]);
      else intentarAvanzar();
    } else if (e.key === 'Escape') {
      cerrarLista();
    }
  });

  campo.addEventListener('blur', () => setTimeout(cerrarLista, 0));

  function intentarAvanzar() {
    if (!respuestas.provincia) {
      aviso.textContent = 'Elige tu provincia de la lista para seguir: es la única pregunta obligatoria.';
      campo.focus();
      return;
    }
    siguiente();
  }
  botonSiguiente.addEventListener('click', intentarAvanzar);

  secciones[0]!.hidden = false;
</script>

<style is:global>
  /* Las pantallas de resultado (docs/design-system.md → Resultado). El DOM lo construye
     src/scripts/resultado.ts con las clases de src/styles/global.css. */
  .fin > .atras { display: block; margin-bottom: var(--s-5); }
  .fin > h2 { margin: var(--s-3) 0 var(--s-4); outline: none; }
  .marca-provisional { margin: 0; }
  .resultado .cobertura { margin: 0 0 var(--s-6); max-width: 62ch; }
  .resultado .resultado-fondo { background: var(--p-surface); border-radius: var(--r-lg); padding: var(--s-6); }
  .resultado .result-foot { margin-top: var(--s-6); }
  .resultado .sin-datos { margin: 0; padding: var(--s-5) var(--s-6); border-radius: var(--r-lg); background: var(--p-bg); font-size: var(--t-lead); max-width: none; }
  .resultado .titular-lista { margin: var(--s-9) 0 0; font-size: var(--t-h2); line-height: 1.1; }
  .resultado .screen--lista { padding: var(--s-6); }
  .resultado .votaciones > li + li { margin-top: var(--s-6); padding-top: var(--s-6); border-top: 1px solid rgb(var(--tinta-rgb) / 0.14); }
  .resultado .vote__head { display: grid; gap: var(--s-2); align-content: start; }
  .resultado .vote__t { margin: 0; }
  .resultado .vote__efecto { font-size: var(--t-small); color: var(--muted); }
  .resultado .vote__cuerpo { display: grid; gap: var(--s-3); align-content: start; }
  .resultado .que-si { font-size: var(--t-small); color: var(--muted); }
  /* Compartir (S-02): vista previa de la imagen a la izquierda y el texto, la casilla y el botón. */
  .resultado .compartir { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--s-6); align-items: start; margin-top: var(--s-6); padding-top: var(--s-6); border-top: 1px solid rgb(var(--tinta-rgb) / 0.14); }
  .resultado .compartir__vista { display: block; width: 216px; height: 270px; border-radius: var(--r-md, 8px); background: var(--p-bg); box-shadow: 0 24px 48px -32px rgb(var(--tinta-rgb) / 0.35); }
  .resultado .compartir__vista:not([src]) { visibility: hidden; }
  .resultado .compartir__texto { display: grid; gap: var(--s-3); align-content: start; }
  .resultado .compartir h3 { margin: 0; font: var(--display-weight) 28px/1.15 var(--font-display); letter-spacing: -0.02em; }
  .resultado .compartir p { margin: 0; font-size: 16px; max-width: 62ch; }
  .resultado .compartir__perfil { display: flex; align-items: center; gap: var(--s-3); margin-top: var(--s-2); }
  .resultado .compartir__perfil label { font-size: 17px; font-weight: 500; cursor: pointer; }
  .resultado .compartir .compartir__ayuda { font-size: var(--t-small); color: var(--muted); padding-left: calc(20px + var(--s-3)); }
  .resultado .compartir .btn-row { margin-top: var(--s-3); }
  .resultado .compartir__estado:empty { display: none; }
  @media (max-width: 639px) {
    .resultado .compartir { grid-template-columns: minmax(0, 1fr); gap: var(--s-4); }
    .resultado .compartir__vista { width: 160px; height: 200px; }
  }
  @media (max-width: 639px) {
    .resultado .resultado-fondo { padding: var(--s-4); }
    .resultado .screen--lista { padding: var(--s-5); }
    .resultado .sin-datos { padding: var(--s-4) var(--s-5); }
    .resultado .titular-lista { margin-top: var(--s-8); }
  }
</style>
