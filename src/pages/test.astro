---
// El cuestionario (M-01) en su propia página. El marcado y los datos están en
// src/components/Cuestionario.astro y el comportamiento en src/scripts/cuestionario.ts; la portada usa
// los mismos para seguir el test sin cambiar de documento. Las respuestas viven solo en memoria: no van
// a la URL, ni a localStorage, ni a ningún servidor (M-08).
import Base from '../layouts/Base.astro';
import Cuestionario from '../components/Cuestionario.astro';
---

<Base titulo="El test · Vota con Criterio" test>
  <Cuestionario />
</Base>

<script>
  import { montarCuestionario } from '../scripts/cuestionario.ts';

  montarCuestionario(document.querySelector<HTMLElement>('[data-cuestionario]')!);
</script>
