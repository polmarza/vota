---
// Portada (M-01) con la estructura de la propuesta Ventana: héroe con la primera pregunta en una
// ventana, una pregunta de ejemplo, un resultado, una votación y el cierre.
//
// El resultado y la votación de ejemplo no se inventan: en el build se calcula el resultado real de
// cada perfil de referencia (data/perfiles-ejemplo.yaml) con el mismo cálculo y los mismos datos que
// /test. En cada visita un script enseña uno al azar y un selector deja cambiar de perfil: los nueve
// están ya en el HTML y solo se muestran u ocultan. Sin JavaScript se ve el primero, sin selector.
import Base from '../layouts/Base.astro';
import PreguntasFrecuentes from '../components/PreguntasFrecuentes.astro';
import { cargarPerfilesEjemplo, cargarPreguntas, cargarTerritorio, datosResultado } from '../lib/datos.ts';
import { calcular, conComunidad } from '../lib/afinidad/calculo.ts';
import { progreso, type PreguntaTest } from '../lib/perfil/cuestionario.ts';
import {
  AVISO_ALCANCE,
  AVISO_PROVISIONAL,
  TEXTO_DESFAVORABLE,
  TEXTO_FAVORABLE,
  estiloPartido,
  etiquetaVoto,
  fechaCorta,
  porcentaje,
} from '../scripts/resultado.ts';

// Las dos preguntas que se enseñan, tal cual están en data/preguntas.yaml.
const preguntas = cargarPreguntas();
const todas: PreguntaTest[] = preguntas.map(({ id, bloque, orden, etiqueta, tipo, obligatoria, solo_si }) => ({ id, bloque, orden, etiqueta, tipo, obligatoria, ...(solo_si && { soloSi: solo_si }) }));
const provincia = preguntas.find((p) => p.id === 'provincia')!;
const vivienda = preguntas.find((p) => p.id === 'vivienda')!;
if (vivienda.tipo !== 'opciones') throw new Error('La pregunta de vivienda tiene que ser de opciones');
const progProvincia = progreso(todas, 'provincia');
const progVivienda = progreso(todas, 'vivienda');
const pct = (f: number) => `${Math.round(f * 100)} %`;

// El resultado real de cada perfil de referencia.
const datos = datosResultado();
const ccaaDe = new Map(cargarTerritorio().provincias.map((p) => [p.id, p.ccaa]));
const partidos = new Map(datos.partidos.map((p) => [p.id, p]));
const fichas = new Map(datos.fichas.map((f) => [f.votacion, f]));
const ejemplos = cargarPerfilesEjemplo().map((perfil) => {
  const respuestas = conComunidad(perfil.respuestas, ccaaDe);
  const enProvincia = datos.porProvincia[respuestas.provincia ?? ''] ?? [];
  const r = calcular(datos.fichas, datos.votos, respuestas, enProvincia);
  if (!r.suficiente) throw new Error(`El perfil de ejemplo "${perfil.nombre}" no tiene votaciones suficientes`);
  const cuentan = r.relevantes.filter((x) => x.sentido !== 'contrapuesta');
  // Las dos votaciones más recientes que cuentan: la primera se enseña entera, la segunda como "la siguiente".
  const recientes = [...cuentan].sort((a, b) => fichas.get(b.votacion)!.fecha.localeCompare(fichas.get(a.votacion)!.fecha)).slice(0, 2);
  const votacion = (v: (typeof recientes)[number]) => {
    const f = fichas.get(v.votacion)!;
    const motivo = f.efectos.find((e) => Object.entries(e.cuando).every(([k, vals]) => respuestas[k] !== undefined && vals.includes(respuestas[k]!)))!;
    return {
      ...f,
      motivo: motivo.justificacion,
      votos: enProvincia.map((id) => ({ partido: partidos.get(id)!, ...etiquetaVoto(datos.votos[f.votacion]?.[id]) })),
    };
  };
  const fila = (p: (typeof r.favorables)[number], clave: 'favorable' | 'desfavorable') => ({
    style: estiloPartido(partidos.get(p.partido)!.color, p[clave]),
    nombre: partidos.get(p.partido)!.nombre,
    detalle: `${clave === 'favorable' ? p.aFavor : p.enContra} de ${p.contadas} votaciones`,
    pct: porcentaje(p[clave]),
  });
  return {
    etiqueta: perfil.nombre,
    nombre: perfil.nombre.charAt(0).toLowerCase() + perfil.nombre.slice(1),
    cuentan: cuentan.length,
    favorables: r.favorables.map((p) => fila(p, 'favorable')),
    desfavorables: r.desfavorables.map((p) => fila(p, 'desfavorable')),
    votacion: votacion(recientes[0]!),
    siguiente: recientes[1] ? votacion(recientes[1]) : undefined,
  };
});
const aviso = AVISO_ALCANCE + (datos.candidaturasProvisionales ? AVISO_PROVISIONAL : '');
const FECHA_LARGA = new Intl.DateTimeFormat('es', { day: 'numeric', month: 'long', timeZone: 'UTC' });
---

<Base portada>
  <section class="hero hero--centred" data-enter aria-labelledby="hero-h">
    <div class="wrap">
      <div class="hero-text">
        <div class="hero__c">
          <a class="pill" href="/test"><span>Elecciones generales</span><span class="muted">29 de noviembre</span></a>
          <h1 id="hero-h">Las promesas vuelan. Los votos se quedan.</h1>
          <p class="hero__lead">
            Cruzamos tus preocupaciones con lo que cada partido votó en el Congreso desde 2019. Así sabes quién estuvo de tu lado cuando tocaba votar.
          </p>
          <div class="btn-row">
            <a class="btn btn--primary" href="/test" data-testid="empezar">
              Empezar el test<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"></path><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"></path></svg>
            </a>
            <a class="btn btn--secondary" href="/como-funciona">Cómo funciona</a>
          </div>
        </div>
        <div class="hero__window" role="img" aria-label={`La primera pregunta del test: ${provincia.enunciado.toLowerCase()}, con Madrid elegida`}>
          <div class="ly-piece q-win" aria-hidden="true">
            <div class="q-win__top"><span>{progProvincia.texto}</span><span>Sin registro</span></div>
            <div class="q-win__bar"><i style={`--avance:${progProvincia.fraccion * 100}%`}></i></div>
            <p class="q-win__q">{provincia.enunciado}</p>
            {provincia.subtitulo && <p class="q-win__sub">{provincia.subtitulo}</p>}
            <div class="q-win__field">
              <span>Madrid</span><svg width="14" height="14" viewBox="0 0 12 12"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="test" aria-labelledby="test-h">
    <div class="wrap">
      <p class="t-label screen-label">Pantalla 2 · Una pregunta</p>
      <div class="grid">
        <h2 id="test-h" class="span-5">Un cuestionario sobre tu vida, no sobre tu opinión</h2>
        <p class="t-lead span-6 start-7 head-line">
          Ocho preguntas básicas y cuatro ampliadas: provincia, vivienda, trabajo, edad, ingresos, hijos. Cada una tiene «Prefiero no responder».
        </p>
      </div>
      <div
        class="ui ui-screen screen"
        role="img"
        aria-label={`La pantalla de una pregunta: ${progVivienda.texto}. ${vivienda.enunciado} ${vivienda.opciones.length} opciones, ${vivienda.opciones[0]!.texto} marcada`}
      >
        <div class="screen__bar" aria-hidden="true"><i></i><i></i><i></i><span>vota.concriterio.blog/test</span></div>
        <div class="quiz" aria-hidden="true">
          <div class="quiz__head">
            <div class="quiz__count"><span>{progVivienda.texto}</span><span>{pct(progVivienda.fraccion)}</span></div>
            <div class="quiz__bar"><i style={`--avance:${progVivienda.fraccion * 100}%`}></i></div>
            <p class="q-win__q">{vivienda.enunciado}</p>
          </div>
          <div class="opts">
            {vivienda.opciones.map((o, i) => <span class:list={['opt', { 'is-on': i === 0, 'opt--ns': o.id === 'ns' }]}><i></i>{o.texto}</span>)}
          </div>
          <span class="quiz__back">← Atrás</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section ground-surface g2m" id="resultado" aria-labelledby="res-h">
    {
      ejemplos.map((e, i) => (
        <div class="wrap" data-ejemplo={i} hidden={i > 0}>
          <div class="group res-group">
            <p class="t-label screen-label" data-aparece>Pantalla 3 · Tu resultado · Un ejemplo real, basado en las {e.cuentan} votaciones que afectan a este perfil</p>
            <div class="section-head">
              <h2 id={i === 0 ? 'res-h' : undefined} data-aparece>Así le sale a: {e.nombre}</h2>
              {
                // El selector es uno solo: el script lo lleva al perfil que se ve. Sin JavaScript no sale.
                i === 0 && (
                  <div class="perfil-hueco">
                    <label class="field perfil-elegir" hidden>
                      <span>Ver otro perfil</span>
                      <select id="perfil-ejemplo" data-testid="perfil-ejemplo">
                        {ejemplos.map((x, j) => <option value={String(j)}>{x.etiqueta}</option>)}
                      </select>
                    </label>
                  </div>
                )
              }
              {i > 0 && <div class="perfil-hueco" />}
            </div>
            <div class="podiums">
              <div class="podium" data-aparece>
                <h3>Estuvieron de tu lado</h3>
                <p>{TEXTO_FAVORABLE}</p>
                <ol>
                  {e.favorables.map((p) => (
                    <li style={p.style}>
                      <span class="who">{p.nombre} <small>{p.detalle}</small></span>
                      <span class="pct">{p.pct}</span>
                      <span class="meter" aria-hidden="true"><i></i></span>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          </div>
          <div class="group res-group">
            <div class="podiums">
              <div class="podium" data-aparece>
                <h3>Votaron en tu contra</h3>
                <p>{TEXTO_DESFAVORABLE}</p>
                <ol>
                  {e.desfavorables.map((p) => (
                    <li style={p.style}>
                      <span class="who">{p.nombre} <small>{p.detalle}</small></span>
                      <span class="pct">{p.pct}</span>
                      <span class="meter" aria-hidden="true"><i></i></span>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
            <div class="result-foot" data-aparece>
              <p>{aviso}</p>
              <div class="btn-row"><a class="btn btn--secondary" href="/test">Haz el test para ver el tuyo</a></div>
            </div>
          </div>
        </div>
      ))
    }
  </section>

  <section class="section" id="votaciones" aria-labelledby="vot-h">
    {
      ejemplos.map((e, i) => (
        <div class="wrap" data-ejemplo={i} hidden={i > 0}>
          <p class="t-label screen-label">Pantalla 3 · La lista de votaciones · {e.nombre}</p>
          <div class="section-head section-head--row">
            <div>
              <h2 id={i === 0 ? 'vot-h' : undefined}>Las votaciones que te afectan</h2>
            </div>
            <a class="link" href={e.votacion.url}>
              Ver la votación del {FECHA_LARGA.format(new Date(e.votacion.fecha))} en el Congreso
            </a>
          </div>
          <div class="ui ui-screen screen">
            <div class="vote">
              <div>
                <time datetime={e.votacion.fecha}>{fechaCorta(e.votacion.fecha)} · {e.votacion.iniciativa}</time>
                <p class="vote__t">{e.votacion.titulo}</p>
              </div>
              <p class="vote__why"><b>Por qué le afecta:</b> {e.votacion.motivo}</p>
              <ul class="tally" aria-label="Qué votó cada partido">
                {e.votacion.votos.map((v) => (
                  <li style={estiloPartido(v.partido.color)}>
                    <span class="p">{v.partido.siglas}</span>
                    <span class:list={['v', { 'v--si': v.si }]}>{v.pildora}</span>
                    {v.desglose && <span class="desglose">{v.desglose}</span>}
                  </li>
                ))}
              </ul>
              <div class="vote__more">
                <a class="quiz__back" href={e.votacion.url}>Ver la votación en el Congreso</a>
              </div>
            </div>
            {e.siguiente && (
              <div class="vote-next">
                <span><b>{e.siguiente.titulo}</b> · {e.siguiente.motivo.charAt(0).toLowerCase() + e.siguiente.motivo.slice(1)}</span>
                <time datetime={e.siguiente.fecha}>{fechaCorta(e.siguiente.fecha)}</time>
              </div>
            )}
          </div>
        </div>
      ))
    }
  </section>

  <section class="section" id="preguntas" aria-labelledby="faq-h">
    <div class="wrap">
      <p class="t-label screen-label">Preguntas frecuentes</p>
      <div class="grid">
        <h2 id="faq-h" class="span-5">Lo que se suele preguntar</h2>
        <div class="span-6 start-7"><PreguntasFrecuentes /></div>
      </div>
    </div>
  </section>

  <!--
    El resultado de ejemplo: un perfil al azar en cada visita y el selector para cambiarlo. Va en línea
    para que el perfil elegido esté puesto antes de pintar. Con movimiento, cada bloque marcado con
    data-aparece entra con un fundido (y sus barras crecen) la primera vez que asoma en pantalla, y otra
    vez al cambiar de perfil; la animación está en el CSS de abajo, aquí solo se marca con .is-visto.
  -->
  <script is:inline>
    (() => {
      const seccion = document.getElementById('resultado');
      const selector = document.getElementById('perfil-ejemplo');
      const conMovimiento = matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window;
      const visor = conMovimiento
        ? new IntersectionObserver((entradas) => {
            for (const e of entradas) if (e.isIntersecting) { e.target.classList.add('is-visto'); visor.unobserve(e.target); }
          }, { rootMargin: '0px 0px -12% 0px' })
        : null;
      if (visor) seccion.classList.add('res-anim');

      const mostrar = (elegido) => {
        // antes de ocultar el perfil anterior, que se lleva el foco si estaba en el selector
        const conFoco = document.activeElement === selector;
        for (const w of document.querySelectorAll('[data-ejemplo]')) {
          const toca = w.dataset.ejemplo === elegido;
          w.hidden = !toca;
          if (toca && visor) for (const b of w.querySelectorAll('[data-aparece]')) { b.classList.remove('is-visto'); visor.observe(b); }
        }
        // los id de los h2 (aria-labelledby de las secciones) van con el perfil que se ve
        for (const id of ['res-h', 'vot-h']) {
          const h = document.getElementById(id);
          const destino = document.querySelector(`#${id === 'res-h' ? 'resultado' : 'votaciones'} [data-ejemplo="${elegido}"] h2`);
          if (h && destino && h !== destino) { h.removeAttribute('id'); destino.id = id; }
        }
        // el selector, al hueco del perfil que se ve (mover un elemento le quita el foco: se le devuelve)
        const hueco = document.querySelector(`#resultado [data-ejemplo="${elegido}"] .perfil-hueco`);
        const campo = selector.closest('label');
        if (hueco && campo.parentElement !== hueco) hueco.append(campo);
        if (conFoco && document.activeElement !== selector) selector.focus();
        selector.value = elegido;
      };

      selector.closest('label').hidden = false;
      selector.addEventListener('change', () => mostrar(selector.value));
      mostrar(String(Math.floor(Math.random() * selector.options.length)));
    })();
  </script>
</Base>

<style is:global>
  /* La página de la maqueta: lo que solo tiene la portada. */
  .hero--centred .hero__c .hero__lead { color: var(--ink); }
  /* el nombre del perfil cambia de largo: la sección crece si lo necesita en vez de pisar la siguiente */
  main > :is(#resultado, #preguntas) { height: auto; min-height: 100vh; min-height: 100svh; }

  @media (max-width: 639px) { .head-line { display: none; } }

  /* el resultado: una pantalla desde 640 (los dos grupos se funden en una rejilla); en el móvil, dos
     pantallas, un podio en cada una */
  @media (min-width: 640px) {
    #resultado > .wrap { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--s-5); align-content: start; }
    #resultado > .wrap[hidden] { display: none; }
    #resultado .res-group, #resultado .podiums { display: contents; }
    #resultado .screen-label, #resultado .section-head, #resultado .result-foot { grid-column: 1 / -1; }
  }
  @media (min-width: 640px) and (max-width: 1023px) { #resultado .podium { grid-column: 1 / -1; margin-bottom: var(--s-5); } }
  @media (max-width: 639px) {
    #resultado .res-group { display: grid; gap: var(--s-5); grid-template-rows: auto auto minmax(0, 1fr); }
    #resultado .res-group + .res-group { grid-template-rows: minmax(0, 1fr) auto; }
    #resultado .podiums { display: contents; }
    .result-foot { margin-top: 0; }
    #resultado .screen-label { margin-bottom: var(--s-3); }
    #resultado .section-head { margin-bottom: 0; }
  }

  /* el selector de perfil, bajo el nombre del perfil */
  #resultado .section-head { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-4); }
  #resultado .perfil-hueco { min-width: 0; }
  #resultado .perfil-elegir { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-4); }
  #resultado .perfil-elegir[hidden] { display: none; }
  #resultado .perfil-elegir select { width: auto; max-width: 100%; min-width: 0; flex: 0 1 auto; background-color: var(--p-bg); }
  @media (max-width: 639px) { #resultado .perfil-elegir select { flex: 1 1 100%; width: 100%; } }

  /* El fundido al entrar en pantalla y las barras que crecen desde 0 (el script de arriba pone
     .res-anim y .is-visto). Son animaciones, no transiciones: un bloque que pasa de oculto a visible al
     cambiar de perfil vuelve a empezarlas. Con movimiento reducido no hay nada de esto: se ve el
     estado final. */
  @media (prefers-reduced-motion: no-preference) {
    .res-anim [data-aparece]:not(.is-visto) { opacity: 0; }
    .res-anim [data-aparece]:not(.is-visto) .meter i { width: 0; }
    .res-anim [data-aparece].is-visto { animation: res-fundido 600ms var(--m-ease-enter) both; }
    .res-anim [data-aparece].is-visto .meter i { animation: res-barra 900ms var(--m-ease-enter) 150ms both; }
    .res-anim .podium li:nth-child(2) .meter i { animation-delay: 230ms; }
    .res-anim .podium li:nth-child(3) .meter i { animation-delay: 310ms; }
  }
  @keyframes res-fundido { from { opacity: 0; } }
  @keyframes res-barra { from { width: 0; } }

  #votaciones .screen { margin-top: 0; padding: var(--s-6); }
  #votaciones .vote-next { margin-top: var(--s-5); }
  @media (max-width: 639px) { .vote-next, .vote__more { display: none; } #votaciones .screen { padding: var(--s-5); } }
</style>
