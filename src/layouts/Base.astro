---
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';

interface Props {
  titulo?: string;
  descripcion?: string;
  compartir?: boolean;
}

const {
  titulo = 'Vota con Criterio',
  descripcion = 'Descubre qué partidos te han favorecido y cuáles te han perjudicado según lo que votaron en el Congreso. Elecciones generales del 29 de noviembre de 2026.',
  compartir = false,
} = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="es_ES" />
  </head>
  <body>
    <div class="pagina">
      <Cabecera compartir={compartir} />
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .pagina {
    max-width: var(--columna);
    min-height: 100dvh;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>
