---
interface Props {
  compartir?: boolean;
}

const { compartir = false } = Astro.props;
---

<header class="cabecera">
  <a class="marca" href="/">
    <span class="logo" aria-hidden="true">v</span>
    <span class="textos">
      <span class="nombre">vota con <i>criterio</i></span>
      <span class="sub">elecciones generales · 29 de noviembre</span>
    </span>
  </a>
  {
    compartir && (
      <button class="compartir" type="button" data-testid="compartir" aria-label="Compartir resultado">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="6" cy="12" r="3" />
          <circle cx="18" cy="6" r="3" />
          <circle cx="18" cy="18" r="3" />
          <path d="M8.7 10.7l6.6 -3.4M8.7 13.3l6.6 3.4" />
        </svg>
      </button>
    )
  }
</header>

<style>
  .cabecera {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px var(--margen) 12px;
    border-bottom: 1px solid var(--tinta);
  }

  .marca {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .logo {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: var(--tinta);
    color: var(--blanco);
    font: 400 20px/1 var(--serif);
    padding-bottom: 3px;
  }

  .textos {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .nombre {
    font: 400 21px/1.05 var(--serif);
  }

  .sub {
    margin-top: 2px;
    font-size: 10.5px;
    color: var(--gris-texto);
  }

  .compartir {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-right: -9px;
    border: 0;
    background: none;
    color: var(--tinta);
    cursor: pointer;
  }
</style>
