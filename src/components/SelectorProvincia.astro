---
// Selector de provincia con autocompletado (docs/design-system.md): patrón ARIA combobox + listbox.
// El comportamiento lo pone src/scripts/selector-provincia.ts, que se monta sobre esta raíz. Los id y
// los data-testid llevan el prefijo para que la portada pueda tener dos copias (la de la ventana del
// héroe y la de la primera pregunta del cuestionario) sin repetirlos; en /test el prefijo es el de
// siempre, "provincia".
interface Props {
  prefijo?: string;
}

const { prefijo = 'provincia' } = Astro.props;
const id = (parte: string) => `${prefijo}-${parte}`;
---

<div class="selector" data-selector-provincia data-prefijo={prefijo}>
  <label class="solo-lector" for={id('campo')}>Provincia</label>
  <input
    id={id('campo')}
    class="campo"
    type="text"
    role="combobox"
    aria-autocomplete="list"
    aria-expanded="false"
    aria-controls={id('lista')}
    aria-describedby={id('aviso')}
    autocomplete="off"
    autocapitalize="words"
    spellcheck="false"
    placeholder="Escribe tu provincia"
    data-testid={id('campo')}
  />
  <ul id={id('lista')} class="lista" role="listbox" aria-label="Provincias" hidden data-testid={id('lista')}></ul>
  <p id={id('aviso')} class="aviso" aria-live="polite" data-aviso data-testid={id('aviso')}></p>
  <button class="btn btn--primary siguiente" type="button" aria-disabled="true" data-siguiente data-testid={id('siguiente')}>Siguiente</button>
</div>

<style>
  .campo {
    width: 100%;
    height: 52px;
    padding: 0 var(--s-4);
    border: 1px solid rgb(var(--tinta-rgb) / 0.35);
    border-radius: var(--r-sm);
    background: var(--p-bg);
    color: var(--ink);
    font: 400 17px/1.3 var(--font-text);
  }

  .campo:hover {
    border-color: rgb(var(--tinta-rgb) / 0.6);
  }

  .campo:focus-visible {
    border-color: var(--ink);
  }

  .campo::placeholder {
    color: var(--muted);
  }

  .lista {
    margin: var(--s-2) 0 0;
    padding: var(--s-1);
    list-style: none;
    border: 1px solid rgb(var(--tinta-rgb) / 0.18);
    border-radius: var(--r-md);
    background: var(--p-bg);
    box-shadow: 0 24px 48px -32px rgb(var(--tinta-rgb) / 0.35);
    max-height: 264px;
    overflow-y: auto;
  }

  .lista :global(li) {
    padding: 10px var(--s-4);
    border-radius: var(--r-sm);
    font-size: 16px;
    cursor: pointer;
  }

  .lista :global(li[aria-selected='true']),
  .lista :global(li:hover) {
    background: var(--ink);
    color: var(--bg);
  }

  .aviso {
    min-height: 1.45em;
    margin: var(--s-2) 0 var(--s-3);
    font-size: 14px;
    line-height: 1.45;
    color: var(--ink);
  }

  .siguiente[aria-disabled='true'] {
    background: var(--p-surface);
    color: var(--muted);
    cursor: not-allowed;
  }
</style>
