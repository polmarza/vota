---
// Selector de provincia con autocompletado (docs/design-system.md): patrón ARIA combobox + listbox.
// La búsqueda la hace src/lib/perfil/provincias.ts desde el script de src/pages/test.astro.
---

<div class="selector" data-selector-provincia>
  <label class="solo-lector" for="provincia-campo">Provincia</label>
  <input
    id="provincia-campo"
    class="campo"
    type="text"
    role="combobox"
    aria-autocomplete="list"
    aria-expanded="false"
    aria-controls="provincia-lista"
    aria-describedby="provincia-aviso"
    autocomplete="off"
    autocapitalize="words"
    spellcheck="false"
    placeholder="Escribe tu provincia"
    data-testid="provincia-campo"
  />
  <ul id="provincia-lista" class="lista" role="listbox" aria-label="Provincias" hidden data-testid="provincia-lista"></ul>
  <p id="provincia-aviso" class="aviso" aria-live="polite" data-testid="provincia-aviso"></p>
  <button class="boton siguiente" type="button" aria-disabled="true" data-siguiente data-testid="provincia-siguiente">Siguiente</button>
</div>

<style>
  .selector {
    margin-top: 24px;
  }

  .campo {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--tinta);
    border-radius: var(--radio);
    background: var(--blanco);
    color: var(--tinta);
    font: 400 16px/1.3 var(--sans);
  }

  .campo::placeholder {
    color: var(--gris-pista);
  }

  .lista {
    margin: 6px 0 0;
    padding: 4px 0;
    list-style: none;
    border: 1px solid var(--gris-borde);
    border-radius: var(--radio);
    max-height: 264px;
    overflow-y: auto;
  }

  .lista :global(li) {
    padding: 10px 16px;
    font-size: 16px;
    cursor: pointer;
  }

  .lista :global(li[aria-selected='true']),
  .lista :global(li:hover) {
    background: var(--tinta);
    color: var(--blanco);
  }

  .aviso {
    min-height: 1.45em;
    margin: 8px 0 12px;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--tinta);
  }

  .siguiente {
    margin-top: 4px;
  }
</style>
